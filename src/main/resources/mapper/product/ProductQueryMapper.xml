<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.mallang.product.adapter.persistence.mybatis.ProductQueryMapper">

    <sql id="productWhere">
        <where>
            <if test="sellerNickname != null and sellerNickname != ''">
                and lower(m.nickname) like concat('%', lower(#{sellerNickname}), '%')
            </if>
            <if test="productName != null and productName != ''">
                and lower(p.name) like concat('%', lower(#{productName}), '%')
            </if>
            <if test="minPrice != null">
                and p.price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                and p.price &lt;= #{maxPrice}
            </if>
            <if test="category != null and category != ''">
                and p.category = #{category}
            </if>
            <if test="lastProductId != null and lastProductId != ''">
                and p.product_id &lt; #{lastProductId}
            </if>
        </where>
    </sql>

    <select id="selectProducts" resultType="io.mallang.product.adapter.persistence.mybatis.model.ProductListRow">
        select
            p.product_id as productId,
            p.seller_id as sellerIdValue,
            m.nickname as sellerNickname,
            p.name,
            p.price,
            p.stock_quantity as stockQuantity,
            p.status,
            p.category,
            pi.image_url as thumbnailImageUrl
        from products p
        join members m on m.member_id = p.seller_id
        left join product_images pi on pi.product_id = p.product_id
                                  and pi.is_thumbnail = true
        <include refid="productWhere"/>
        order by p.product_id desc
        limit #{limit}
    </select>
</mapper>
